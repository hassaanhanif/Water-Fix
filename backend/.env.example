PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/waterfix_db
JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
COMMISSION_RATE=0.10
ADMIN_SETTLEMENT_KEY=replace_with_admin_settlement_key
ADMIN_EMAIL=admin@waterfix.pk
ADMIN_PASSWORD=AdminPass123!
ADMIN_PHONE=+923000000000
ADMIN_NAME=WaterFix Administrator
NODE_ENV=development

# Safepay Test Mode (Sandbox) Configuration
SAFEPAY_ENV=sandbox
SAFEPAY_API_KEY=sec_sandbox_replace_with_your_safepay_api_key
SAFEPAY_SECRET_KEY=replace_with_your_safepay_secret_key
SAFEPAY_WEBHOOK_SECRET=replace_with_your_safepay_webhook_secret
SAFEPAY_BASE_URL=https://sandbox.api.getsafepay.com
SAFEPAY_CHECKOUT_BASE_URL=https://sandbox.api.getsafepay.com/checkout/pay
SAFEPAY_REDIRECT_URL=http://localhost:5000/api/wallet/safepay/callback
SAFEPAY_CANCEL_URL=http://localhost:5000/api/wallet/safepay/cancel

# Brevo (Sendinblue) Transactional SMTP Configuration
# Get these from your Brevo Dashboard: Settings -> SMTP & API -> SMTP tab
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_smtp_login
SMTP_PASSWORD=your_brevo_smtp_master_password
SMTP_FROM_EMAIL=your_verified_sender_email@domain.com


